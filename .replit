run = "cd minecraft-server && bash start.sh"
entrypoint = "minecraft-server/start.sh"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 23333
externalPort = 3001

[[ports]]
localPort = 24444
externalPort = 3000
exposeLocalhost = true

[deployment]
build = ["sh", "-c", "cd minecraft-server && for d in . mcsmanager/daemon mcsmanager/web middleware; do (cd \"$d\" && [ -f package.json ] && (npm ci --omit=dev --no-audit --no-fund || npm install --omit=dev --no-audit --no-fund)); done"]
run = ["sh", "-c", "cd minecraft-server && bash deploy-start.sh"]
deploymentTarget = "cloudrun"

[nix]
channel = "stable-24_05"
packages = ["lsof"]
